   var bootstrapAbort = null;
   var portAbort = null;

   function registerBootstrapListener() {
       if (bootstrapAbort) { bootstrapAbort.abort(); }
       bootstrapAbort = new AbortController();
       window.addEventListener("jshelter-bootstrap", function (e) {
           ...validace...
           if (portAbort) { portAbort.abort(); }   // při resetu/redirectu starý port zahodit
           portAbort = new AbortController();
           window.addEventListener(portId + ":page", function (event) { ... },
               {capture: true, signal: portAbort.signal});
           window.addEventListener(portId + ":return:page", function (event) { ... },
               {capture: true, signal: portAbort.signal});
           ...
       }, {once: true, capture: true, signal: bootstrapAbort.signal});
   }

   function resetDocumentStart() {
       bootstrapSealed = false;
       initAnswered = false;
       wrappersPort = null;
       pendingConfig = null;
       pageConfiguration = null;
       if (bootstrapAbort) { bootstrapAbort.abort(); bootstrapAbort = null; }
       if (portAbort) { portAbort.abort(); portAbort = null; }
       registerBootstrapListener();
   }
