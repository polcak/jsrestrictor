    it("a malformed bootstrap disables the port for the document (documented behavior)", function () {
        // malformed event: consumed the {once: true} listener, sealed nothing
        window.dispatchEvent(new CustomEvent("jshelter-bootstrap", {}));

        // genuine bootstrap arrives too late — must be ignored
        window.dispatchEvent(new CustomEvent("jshelter-bootstrap",
            {detail: {portId: "real"}}));

        // Probe the port: if it were established, the listener would answer
        // any message with a "real:return:extension" event (even when the
        // value is undefined, the event itself fires).
        const responses = [];
        window.addEventListener("real:return:extension", function (e) {
            responses.push(e.detail);
        }, true);
        window.dispatchEvent(new CustomEvent("real:page",
            {detail: {msg: {init: true}}}));

        expect(responses).toEqual([]);
    });
