    describe("bootstrap handshake hardening", function () {
        beforeEach(function () {
            // reset vnitřního stavu vystaveného přes remove_custom_namespace
            initAnswered = false;
            bootstrapSealed = false;
            wrappersPort = null;
            pendingConfig = null;
            pageConfiguration = null;
            registerBootstrapListener(); // vyžaduje výše uvedený refaktor
        });

        it("rejects a forged bootstrap after the real handshake", function () {
            const realResponses = jasmine.createSpy();
            window.addEventListener("real:return:extension", realResponses, true);

            window.dispatchEvent(new CustomEvent("jshelter-bootstrap",
                {detail: {portId: "real"}}));
            // padělaný bootstrap od "stránky" se svým portId
            window.dispatchEvent(new CustomEvent("jshelter-bootstrap",
                {detail: {portId: "attacker"}}));
            // útočníkův pull přes padělaný kanál
            window.dispatchEvent(new CustomEvent("attacker:page",
                {detail: {msg: {init: true}}}));

            expect(realResponses).not.toHaveBeenCalled();
            // a kanál útočníka nedostal žádnou odpověď: otestujeme přes listener
            const attackerResponses = jasmine.createSpy();
            window.addEventListener("attacker:return:extension", attackerResponses, true);
            window.dispatchEvent(new CustomEvent("attacker:page",
                {detail: {msg: {init: true}}}));
            expect(attackerResponses).not.toHaveBeenCalled();
        });

        it("does not throw on malformed bootstrap events", function () {
            expect(function () {
                window.dispatchEvent(new CustomEvent("jshelter-bootstrap", {}));
            }).not.toThrow();
            expect(function () {
                window.dispatchEvent(new CustomEvent("jshelter-bootstrap",
                    {detail: {portId: 1234}}));
            }).not.toThrow();
        });

        it("answers {init: true} at most once", function () {
            const conf = {domainHash: "deadbeef", currentLevel: {level_id: "2"}};
            pendingConfig = conf;
            const handler = createHandleWrappersPortMessage(() => pendingConfig);

            expect(handler({init: true})).toBe(conf);
            expect(handler({init: true})).toBeUndefined(); // druhý pull neodpoví
        });

        it("keeps FPD forwarding working for non-init messages", function () {
            spyOn(browser.runtime, "sendMessage");
            const handler = createHandleWrappersPortMessage(() => null);
            handler({access: "call", resource: "SomeAPI"});
            expect(browser.runtime.sendMessage).toHaveBeenCalledWith({
                purpose: "fp-detection",
                content: {access: "call", resource: "SomeAPI"}
            });
        });

        it("pushes pendingConfig over an established port", function () {
            const pushed = jasmine.createSpy();
            window.addEventListener("real:extension", function (e) {
                pushed(e.detail.msg);
            }, true);

            pendingConfig = {domainHash: "x", currentLevel: {}, fpdWrappers: []};
            window.dispatchEvent(new CustomEvent("jshelter-bootstrap",
                {detail: {portId: "real"}}));
            // synchronní CustomEvent kanál: postMessage v handleru už proběhl
            expect(pushed).toHaveBeenCalledWith(
                jasmine.objectContaining({domainHash: "x"}));
        });

        it("configureInjection stores and pushes config on the Chrome path", function () {
            // v testovacím prostředí není exportFunction definováno,
            // takže se přirozeně vykoná Chrome větev
            const ok = configureInjection({
                currentLevel: {level_id: "2"},
                fpdWrappers: [],
                fpdTrackCallers: false,
                domainHash: "d",
                incognitoHash: "i"
            });
            expect(ok).toBeTrue();
            expect(pendingConfig.domainHash).toBe("d");
            expect(pendingConfig.currentLevel).toEqual({level_id: "2"});
            // opakované volání je one-shot
            expect(configureInjection({currentLevel: {level_id: "3"}})).toBeUndefined();
        });
    });
